{
	"name": "Filesystem",
	"properties": {
		"description": "coppy data from onprime to online ",
		"activities": [
			{
				"name": "Coppy",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "FileServerReadSettings",
							"recursive": true,
							"deleteFilesAfterCompletion": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "CoppyFromLocalSystem",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "CoppyCsvFiles",
						"type": "DatasetReference",
						"parameters": {
							"NewFolder": "ALLFILES"
						}
					}
				]
			}
		],
		"annotations": []
	}
}